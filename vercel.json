{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog/:slug", "destination": "https://marektopolar.com/blog/:slug", "permanent": true },
    { "source": "/blog", "destination": "https://marektopolar.com/blog", "permanent": true },
    { "source": "/about", "destination": "https://marektopolar.com/about", "permanent": true },
    { "source": "/privacy", "destination": "https://marektopolar.com/privacy", "permanent": true },
    { "source": "/terms", "destination": "https://marektopolar.com/terms", "permanent": true },
    { "source": "/hvco-guide", "destination": "https://marektopolar.com/tools", "permanent": true },
    { "source": "/", "destination": "https://marektopolar.com/", "permanent": true }
  ]
}
